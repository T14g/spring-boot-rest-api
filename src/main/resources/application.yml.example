spring:
  application:
    name: rest-with-spring-boot-and-java-tiger
  datasource:
    url: jdbc:mysql://localhost:3306/banco-spring?useTimezone=true&serverTimezone=UTC
    username: root
    password: your-local-password
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
    show_sql: false
